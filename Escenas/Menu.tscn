[connection signal="pressed" from="Botones/BotonNivel1" to="." method="_on_nivel_1_pressed"]
[connection signal="pressed" from="Botones/BotonNivel2" to="." method="_on_nivel_2_pressed"]
[connection signal="pressed" from="Botones/BotonNivel3" to="." method="_on_nivel_3_pressed"]
